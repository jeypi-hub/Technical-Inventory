# ==============================================================================
# ACLC Technical Equipment Inventory System — .gitignore
# Production-Grade Secret & Artifact Exclusion Rules
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secret Credentials
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
*.env.local
*.env.production
*.env.staging

# Local Configuration Overrides
config/*.local.php
config/local.*.php
config/secrets.php
config.local.php
*.local.ini
*.local.conf

# Private Keys, Certificates & Tokens
*.pem
*.key
*.crt
*.p12
*.pfx
*.pkcs12
*.cer
*.der
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
credentials.json
client_secret*.json
service-account*.json
token.json
oauth-*.json

# ------------------------------------------------------------------------------
# 2. Application Logs, Mail Logs & Runtime Data
# ------------------------------------------------------------------------------
*.log
*.log.*
logs/
assets/upload/*.log
assets/upload/mail.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ------------------------------------------------------------------------------
# 3. Dynamic User Uploads & Media Files
# ------------------------------------------------------------------------------
# Ignore all dynamically generated uploads while keeping directory structure
assets/upload/eq_*
assets/upload/profile_*
assets/upload/avatar_*
assets/upload/user_*
assets/upload/temp_*
assets/upload/cache/
!assets/upload/.gitkeep

# ------------------------------------------------------------------------------
# 4. Database Backups, Dumps & Temp SQL
# ------------------------------------------------------------------------------
*.sql.bak
*.sql.old
*.sql.temp
*.sql.gz
*.sql.zip
*.dump
*.sqlite
*.sqlite3
*.db
backups/
database/backups/
export/
*.xls
*.xlsx
*.csv

# ------------------------------------------------------------------------------
# 5. Operating System Junk
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?
ehthumbs.db
Thumbs.db

# Windows
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory

# ------------------------------------------------------------------------------
# 6. IDEs & Editor Configuration
# ------------------------------------------------------------------------------
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# ------------------------------------------------------------------------------
# 7. Package Managers & Build Artifacts
# ------------------------------------------------------------------------------
vendor/
composer.phar
node_modules/
dist/
build/
.cache/
.tmp/
/tmp/
/temp/
