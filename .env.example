# ==============================================================================
# ACLC Technical Equipment Inventory System — Environment Template
# Duplicate this file as .env or use for server-level environment variables.
# NEVER commit your actual .env file or real passwords to version control!
# ==============================================================================

# Application Environment
APP_NAME="ACLC Technical Inventory"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/Technical_Inventory/

# Database Connection (MySQL 8.0 InnoDB)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=technical_inventory
DB_USER=root
DB_PASS=

# Mail & SMTP Notification Configuration
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your-inventory-alert@gmail.com
MAIL_PASSWORD=your-16-character-app-password
MAIL_FROM_ADDRESS=no-reply@aclc.edu.ph
MAIL_FROM_NAME="ACLC Technical Inventory"
